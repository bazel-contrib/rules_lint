"Bazel dependencies for Rust lint support"

module(
    name = "rules_lint_rules_rust",
    bazel_compatibility = [">=7.6.0"],
)

bazel_dep(name = "rules_lint")
bazel_dep(name = "aspect_rules_js", version = "3.6.1")
bazel_dep(name = "bazel_lib", version = "3.8.0")
bazel_dep(name = "rules_rust", version = "0.75.0")
bazel_dep(name = "rules_shell", version = "0.8.0")

local_path_override(
    module_name = "rules_lint",
    path = "../..",
)
